# Copy this file to .env in this folder, then fill in your key.
# Folium reads .env automatically. Never commit a real key.
# Alternatively use Windows environment variables or the app's Settings.
GEMINI_API_KEY=
# Optional extra keys. Outgoing requests rotate through distinct configured keys.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TASK_MODEL=gemini-3.5-flash-lite
# Optional separate model for explicitly requested learning-PDF visual analysis.
# Leave blank to use GEMINI_TASK_MODEL. This does not enable scanned-PYQ transcription.
GEMINI_VISION_MODEL=
FOLIUM_PORT=8765
# Optional lesson tutor. Only sending a question contacts Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
